# ==========================================
# CHEZ VOUS - API DE DEPARTAMENTOS & COLABORADORES
# ==========================================
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_BASE_PATH=
API_PORT=8011
MYSQL_PORT=3308
PHPMYADMIN_PORT=8012

# CORS & Segurança
CORS_ALLOWED_ORIGINS=*
ADMIN_API_KEY=cv_admin_secret_key_2026_dev

# Banco de Dados MySQL
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=chezvous_departamentos
DB_USERNAME=chezvous_user
DB_PASSWORD=chezvous_pass_secret
DB_ROOT_PASSWORD=chezvous_root_secret

# Redis (Fallback automático ativo)
REDIS_HOST=redis
REDIS_PORT=6379

# Rate Limiting
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_GENERAL_PER_MIN=300
